<?xml version="1.0" encoding="utf-8"?>
<!-- Demo 3 loại ad mới của 1.0.28 (bản XML): inter + native full story, native PIP, native collapsible. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btn_inter_story"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inter + native full story" />

        <Button
            android:id="@+id/btn_pip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Native PIP (kéo thả)" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_native_collapsible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
